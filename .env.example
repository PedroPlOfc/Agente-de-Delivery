# Copie este arquivo para .env antes de iniciar o projeto.
# Estes valores são apenas para desenvolvimento local. Troque todas as senhas/chaves em produção.

# PostgreSQL compartilhado entre o CANA e a Evolution API
POSTGRES_DB=evolution
POSTGRES_USER=evolution
POSTGRES_PASSWORD=my_password
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/evolution
SPRING_DATASOURCE_USERNAME=evolution
SPRING_DATASOURCE_PASSWORD=my_password
DB_POOL_SIZE=10

# Token entre o Python e a API Java (use o mesmo valor nos dois serviços)
INTERNAL_API_TOKEN=cana_internal_local_change_me
ADMIN_TOKEN_SECRET=cana-dev-admin-token-secret-change-before-production-2026
JAVA_API_URL=http://java-api:8081
JAVA_API_TIMEOUT=8

# Python / FastAPI
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500
WEBHOOK_TOKEN=

# IA (opcional para iniciar; sem chave, o motor local funciona com recursos reduzidos)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=
OPENAI_API_KEY=

# Evolution API / WhatsApp
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_LOCAL_API_URL=http://localhost:8080
EVOLUTION_API_KEY=cana_evolution_local_change_me
EVOLUTION_INSTANCE=cana_delivery
EVOLUTION_API_VERSION=2
